PORT=3001
HOST=0.0.0.0
# Optional custom staff domain, without https:// (for example staff.example.com).
STAFF_PANEL_HOST=
# Comma-separated browser origins allowed to call this API. Empty means same-origin only.
CORS_ALLOWED_ORIGINS=
# Defaults to public/uploads. On Railway, mount a volume at /app/public/uploads and set this to the same path.
UPLOADS_DIR=
# Set DATABASE_URL instead of the split fields below when using a MySQL URL.
DATABASE_URL=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=replace-with-your-local-mysql-password
DATABASE_NAME=myapp_db
ZAPUPI_USER_TOKEN=replace-with-your-merchant-user-token
ZAPUPI_SECRET_KEY=replace-with-your-webhook-hmac-secret
ZAPUPI_REDIRECT_URL=https://your-public-site.example/wallet
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM=BattleNext Admin <admin@example.com>
# Leave the file path empty when configuring Firebase through environment variables.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Alternatively, set all three Firebase fields.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
PUBLIC_BASE_URL=https://your-public-api.example
# Optional; only needed if Expo Push access-token security is enabled for iOS delivery.
EXPO_ACCESS_TOKEN=
